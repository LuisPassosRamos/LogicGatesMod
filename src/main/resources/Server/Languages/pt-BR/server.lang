items.logic_lever.name = Alavanca Lógica
items.logic_lever.description = Fornece sinal 1 quando ligada e sinal 0 quando desligada. Interaja para alternar.
items.logic_cable.name = Cabo Lógico
items.logic_cable.description = Conecta componentes no mesmo nível. Ramificações compartilham o sinal de suas fontes.
items.logic_lamp.name = Lâmpada Lógica
items.logic_lamp.description = Acende ao receber sinal 1. Não transmite sinal entre trechos de cabo.
items.logic_and_gate.name = Porta Lógica AND
items.logic_and_gate.description = Liga quando todas as entradas conectadas recebem 1. A: esquerda; B: direita; C: atrás; saída: seta frontal. Entradas vazias são ignoradas. Sem entradas conectadas: 0.
items.logic_or_gate.name = Porta Lógica OR
items.logic_or_gate.description = Liga quando alguma entrada conectada recebe 1. A: esquerda; B: direita; C: atrás; saída: seta frontal. Entradas vazias são ignoradas. Sem entradas conectadas: 0.
items.logic_not_gate.name = Porta Lógica NOT
items.logic_not_gate.description = Inverte C, atrás: 0 vira 1 e 1 vira 0. Saída: seta frontal. Laterais fechadas. Sem entrada conectada: 0.
items.logic_nand_gate.name = Porta Lógica NAND
items.logic_nand_gate.description = Inverte AND: desliga quando todas as entradas conectadas recebem 1. A: esquerda; B: direita; C: atrás; saída: seta frontal. Sem entradas conectadas: 0.
items.logic_nor_gate.name = Porta Lógica NOR
items.logic_nor_gate.description = Inverte OR: liga quando todas as entradas conectadas recebem 0. A: esquerda; B: direita; C: atrás; saída: seta frontal. Sem entradas conectadas: 0.
items.logic_xor_gate.name = Porta Lógica XOR
items.logic_xor_gate.description = Liga com quantidade ímpar de entradas em 1 (uma ou três). A/B: laterais; C: atrás; saída: seta frontal. Cada face conta, mesmo ligada à mesma rede. Sem entradas conectadas: 0.
items.logic_xnor_gate.name = Porta Lógica XNOR
items.logic_xnor_gate.description = Inverte XOR: liga com quantidade par de entradas em 1 (zero ou duas), havendo conexão. A/B: laterais; C: atrás; saída: seta frontal. Sem entradas conectadas: 0.

