Button {
  Anchor: (Height: 132, Bottom: 6);
  LayoutMode: Left;
  Padding: (Full: 12);
  Background: (Color: #233047);
  Style: (
    Default: (Background: (Color: #233047)),
    Hovered: (Background: (Color: #30445f)),
    Pressed: (Background: (Color: #3b577a))
  );
  Group #SelectionMark { Visible: false; Anchor: (Width: 4, Right: 8); Background: (Color: #7cb7ee); }
  Group {
    FlexWeight: 1;
    LayoutMode: Top;
    Group {
      LayoutMode: Left;
      Anchor: (Height: 44);
      Label #RowName { FlexWeight: 1; Anchor: (Right: 8); Style: (FontSize: 20, Wrap: true, TextColor: #ffffff); }
      Label #RowProgress { Visible: false; Anchor: (Width: 110); Style: (FontSize: 16, Wrap: true, TextColor: #7cb7ee, HorizontalAlignment: End); }
    }
    Label #RowInfo { Anchor: (Height: 40); Style: (FontSize: 16, Wrap: true, TextColor: #b4c4d8); }
    Label #RowStamp { Visible: false; Anchor: (Height: 22); Style: (FontSize: 13, TextColor: #9daec2); }
  }
}
