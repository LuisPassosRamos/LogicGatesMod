$C = "../../Common.ui";
@DeadlineStyle = DropdownBoxStyle(
  ...$C.@DefaultDropdownBoxStyle,
  LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, FontSize: 17),
  EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, FontSize: 17),
  SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, FontSize: 17, RenderBold: true),
  EntryHeight: 36
);
$C.@PageOverlay {}
$C.@Container {
  Anchor: (Full: 16);
  #Title { $C.@Title { @Text = %server.logicgates.learning.activities; } }
  #Content {
    LayoutMode: Top;
    Padding: (Full: 24);
    Group {
      LayoutMode: LeftWrap;
      Anchor: (Bottom: 8);
      $C.@SecondaryTextButton #Back { @Text = %server.logicgates.learning.classroom; Anchor: (Width: 180, Right: 8, Height: 48); }
      $C.@SecondaryTextButton #Activities { @Text = %server.logicgates.learning.activities; Anchor: (Width: 260, Right: 8, Height: 48); }
      $C.@SecondaryTextButton #Filter { @Text = %server.logicgates.learning.filter.ALL; Anchor: (Width: 240, Right: 8, Height: 48); Visible: false; }
      $C.@TextButton #New { @Text = %server.logicgates.learning.newActivity; Anchor: (Width: 240, Height: 48); Visible: false; }
    }
    Label #Heading { Anchor: (Bottom: 12); Style: (FontSize: 24, TextColor: #ffffff, Wrap: true); }
    Group #Body {
      FlexWeight: 1;
      LayoutMode: Left;
      Group #ListPanel {
        FlexWeight: 1;
        Anchor: (MinWidth: 240, MaxWidth: 440, Right: 20);
        LayoutMode: Top;
        Group {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Label #Empty { Anchor: (Height: 70); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
          Group #Rows { LayoutMode: Top; }
        }
        Label #Page { Anchor: (Height: 24); Style: (FontSize: 16, HorizontalAlignment: Center, TextColor: #9daec2); }
        Group {
          LayoutMode: LeftWrap;
          $C.@SecondaryTextButton #Previous { @Text = %server.logicgates.classroom.previous; Anchor: (Width: 152, Right: 8, Bottom: 6, Height: 48); }
          $C.@SecondaryTextButton #Next { @Text = %server.logicgates.classroom.next; Anchor: (Width: 152, Bottom: 6, Height: 48); }
        }
      }
      Group #Details {
        FlexWeight: 3;
        Anchor: (MinWidth: 280);
        LayoutMode: Top;
        Group {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group #Editor {
            Visible: false;
            LayoutMode: Top;
            Label { Anchor: (Bottom: 4); Text: %server.logicgates.learning.title; Style: (FontSize: 19, Wrap: true, TextColor: #ffffff); }
            $C.@TextField #TitleField { Anchor: (Bottom: 8, Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 128; }
            Label { Anchor: (Bottom: 4); Text: %server.logicgates.learning.description; Style: (FontSize: 19, Wrap: true, TextColor: #ffffff); }
            $C.@MultilineTextField #DescriptionField { Anchor: (Height: 200, Bottom: 8); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 8192; }
            Label { Anchor: (Bottom: 4); Text: %server.logicgates.learning.deadline; Style: (FontSize: 18, Wrap: true, TextColor: #ffffff); }
            Group #DeadlineControls {
              LayoutMode: LeftWrap;
              Group {
                LayoutMode: Top;
                Anchor: (Width: 100, Right: 12, Bottom: 12);
                Label { Text: %server.logicgates.learning.day; Style: (FontSize: 18, TextColor: #9daec2); Anchor: (Bottom: 4); }
                DropdownBox #DeadlineDay { Anchor: (Height: 44); Style: @DeadlineStyle; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 180, Right: 12, Bottom: 12);
                Label { Text: %server.logicgates.learning.month; Style: (FontSize: 18, TextColor: #9daec2); Anchor: (Bottom: 4); }
                DropdownBox #DeadlineMonth { Anchor: (Height: 44); Style: @DeadlineStyle; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 130, Right: 12, Bottom: 12);
                Label { Text: %server.logicgates.learning.year; Style: (FontSize: 18, TextColor: #9daec2); Anchor: (Bottom: 4); }
                DropdownBox #DeadlineYear { Anchor: (Height: 44); Style: @DeadlineStyle; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 100, Right: 12, Bottom: 12);
                Label { Text: %server.logicgates.learning.hour; Style: (FontSize: 18, TextColor: #9daec2); Anchor: (Bottom: 4); }
                DropdownBox #DeadlineHour { Anchor: (Height: 44); Style: @DeadlineStyle; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 100, Right: 12, Bottom: 12);
                Label { Text: %server.logicgates.learning.minute; Style: (FontSize: 18, TextColor: #9daec2); Anchor: (Bottom: 4); }
                DropdownBox #DeadlineMinute { Anchor: (Height: 44); Style: @DeadlineStyle; }
              }
            }
            Label { Anchor: (Bottom: 4); Text: %server.logicgates.learning.value; Style: (FontSize: 19, Wrap: true, TextColor: #ffffff); }
            $C.@TextField #ValueField { Anchor: (Width: 220, Bottom: 12, Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 16; }
            Label { Anchor: (Top: 8, Bottom: 6); Text: %server.logicgates.learning.requirements; Style: (FontSize: 20, Wrap: true, TextColor: #ffffff); }
            Label { Anchor: (Bottom: 10); Text: %server.logicgates.learning.requirementsHelp; Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
            Group {
              LayoutMode: LeftWrap;
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: %server.logicgates.learning.moduleLever; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredLEVER { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: %server.logicgates.learning.moduleCable; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredCABLE { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: %server.logicgates.learning.moduleLamp; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredLAMP { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "AND"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredAND { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "OR"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredOR { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "NOT"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredNOT { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "NAND"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredNAND { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "NOR"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredNOR { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "XOR"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredXOR { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "XNOR"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredXNOR { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
            }
            Label { Anchor: (Top: 8, Bottom: 6); Text: %server.logicgates.learning.expectedTable; Style: (FontSize: 20, Wrap: true, TextColor: #ffffff); }
            Label { Anchor: (Bottom: 10); Text: %server.logicgates.learning.tableHelp; Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
            $C.@MultilineTextField #TruthTableField { Anchor: (Height: 220, Bottom: 12); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 4096; }
          }
          Group #Read {
            Visible: false;
            LayoutMode: Top;
            Group {
              LayoutMode: LeftWrap;
              Anchor: (Bottom: 12);
              Label #ReadTitle { FlexWeight: 1; Anchor: (MinWidth: 200, Right: 12, Bottom: 8); Style: (FontSize: 28, Wrap: true, TextColor: #ffffff); }
              $C.@TextButton #Edit { @Text = %server.logicgates.learning.editActivity; Anchor: (Width: 260, Height: 48, Bottom: 8); Visible: false; }
            }
            Label #ReadState { Anchor: (Bottom: 8); Style: (FontSize: 19, Wrap: true, TextColor: #7cb7ee); }
            Label #StudentInfo { Anchor: (Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            Label #ReadMeta { Anchor: (Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
            Label #DraftNotice { Anchor: (Bottom: 12); Style: (FontSize: 19, Wrap: true, TextColor: #efbb73); Visible: false; }
            Label #DeadlineState { Anchor: (Bottom: 8); Text: %server.logicgates.learning.deadlineClosed; Style: (FontSize: 18, Wrap: true, TextColor: #efbb73); Visible: false; }
            Label #ReadDescription { Anchor: (Bottom: 8); Style: (FontSize: 19, Wrap: true, TextColor: #c8d3e0); }
            Label #ReadRequirements { Anchor: (Top: 8, Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            Label #ReadTable { Anchor: (Bottom: 12); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            Label #ActivityScore { Anchor: (Bottom: 8); Style: (FontSize: 19, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            Label #NoSubmission { Anchor: (Bottom: 8); Text: %server.logicgates.learning.notSubmitted; Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); Visible: false; }
          }
          Group #Submission {
            Visible: false;
            LayoutMode: Top;
            Label #VersionSnapshot { Anchor: (Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            Label #SubmissionRules { Anchor: (Bottom: 12); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            Label #VerificationResults { Anchor: (Bottom: 16); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            Label #SubmissionMeta { Anchor: (Bottom: 6); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
            PrefabPreviewComponent #PrefabPreview { Anchor: (Height: 360, Bottom: 16); AllowDragYaw: true; AllowDragPitch: true; AllowZoom: true; AllowPan: true; ShowAnchor: true; }
            Label #Assessment { Anchor: (Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
            Label #FeedbackText { Anchor: (Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
            Group #GradeEditor {
              Visible: false;
              LayoutMode: Top;
              Label { Anchor: (Bottom: 4); Text: %server.logicgates.learning.score; Style: (FontSize: 19, Wrap: true, TextColor: #ffffff); }
              $C.@TextField #ScoreField { Anchor: (Width: 220, Bottom: 12, Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 16; }
              Label { Anchor: (Bottom: 4); Text: %server.logicgates.learning.feedback; Style: (FontSize: 19, Wrap: true, TextColor: #ffffff); }
              $C.@MultilineTextField #FeedbackField { Anchor: (Height: 160, Bottom: 8); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 4096; }
            }
          }
        }
        Group #ActionDock {
          LayoutMode: Top;
          Anchor: (Top: 8);
          Group #ActivityActions {
            LayoutMode: LeftWrap;
            Anchor: (Bottom: 6);
            Visible: false;
            $C.@TextButton #SaveDraft { @Text = %server.logicgates.learning.saveDraft; Anchor: (Width: 250, Right: 8, Bottom: 6, Height: 48); }
            $C.@TextButton #Publish { @Text = %server.logicgates.learning.publish; Anchor: (Width: 160, Right: 8, Bottom: 6, Height: 48); }
            $C.@SecondaryTextButton #CancelEdit { @Text = %server.logicgates.learning.cancelEdit; Anchor: (Width: 280, Bottom: 6, Height: 48); Visible: false; }
          }
          Group #CatalogActions {
            LayoutMode: LeftWrap;
            Anchor: (Bottom: 6);
            Visible: false;
            $C.@SecondaryTextButton #Archive { @Text = %server.logicgates.learning.archive; Anchor: (Width: 190, Right: 8, Bottom: 6, Height: 48); Visible: false; }
            $C.@SecondaryTextButton #Restore { @Text = %server.logicgates.learning.restore; Anchor: (Width: 190, Bottom: 6, Height: 48); Visible: false; }
          }
          $C.@SecondaryTextButton #Students { @Text = %server.logicgates.learning.students; Anchor: (Bottom: 6, Height: 48); Visible: false; }
          $C.@TextButton #Deliver { @Text = %server.logicgates.learning.deliver; Anchor: (Bottom: 6, Height: 48); Visible: false; }
          $C.@TextButton #SubmitArea { @Text = %server.logicgates.learning.submitArea; Anchor: (Bottom: 6, Height: 48); Visible: false; }
          $C.@SecondaryTextButton #CancelSelection { @Text = %server.logicgates.learning.cancelSelection; Anchor: (Bottom: 6, Height: 48); Visible: false; }
          Group #RevisionActions {
            Visible: false;
            LayoutMode: LeftWrap;
            Anchor: (Bottom: 6);
            $C.@SecondaryTextButton #Newer { @Text = %server.logicgates.learning.newer; Anchor: (Width: 240, Right: 8, Bottom: 6, Height: 48); }
            $C.@SecondaryTextButton #Older { @Text = %server.logicgates.learning.older; Anchor: (Width: 240, Bottom: 6, Height: 48); }
          }
          Group #ReviewActions {
            Visible: false;
            LayoutMode: LeftWrap;
            Anchor: (Bottom: 6);
            $C.@SecondaryTextButton #Verify { @Text = %server.logicgates.learning.verify; Anchor: (Width: 260, Right: 8, Bottom: 6, Height: 48); Visible: false; }
            $C.@TextButton #SaveGrade { @Text = %server.logicgates.learning.saveGrade; Anchor: (Width: 250, Right: 8, Bottom: 6, Height: 48); }
            $C.@SecondaryTextButton #Paste { @Text = %server.logicgates.learning.paste; Anchor: (Width: 240, Right: 8, Bottom: 6, Height: 48); }
          }
          $C.@CancelTextButton #Discard { @Text = %server.logicgates.learning.discard; Anchor: (Top: 6, Height: 48); Visible: false; }
        }
      }
    }
    Label #Status { Anchor: (Top: 12, Bottom: 12); Text: %server.logicgates.learning.loading; Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
    Group {
      LayoutMode: Top;
      Group {
        LayoutMode: LeftWrap;
        $C.@SecondaryTextButton #Reload { @Text = %server.logicgates.classroom.reload; Anchor: (Width: 180, Right: 8, Height: 48); }
        $C.@CancelTextButton #Close { @Text = %server.logicgates.classroom.probe.close; Anchor: (Width: 156, Right: 12, Height: 48); }
      }
      Label #Build { Anchor: (Top: 6); Style: (FontSize: 12, Wrap: true, TextColor: #9daec2); }
    }
  }
}
