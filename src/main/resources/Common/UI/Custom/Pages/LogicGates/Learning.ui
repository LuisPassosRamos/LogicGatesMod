$C = "../../Common.ui";
@DeadlineStyle = DropdownBoxStyle(
  ...$C.@DefaultDropdownBoxStyle,
  LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, FontSize: 17),
  EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, FontSize: 17),
  SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, FontSize: 17, RenderBold: true),
  EntryHeight: 32,
  EntriesInViewport: 4,
  PanelAlign: Bottom
);
$C.@PageOverlay {}
$C.@Container {
  Anchor: (Full: 16);
  #Title { $C.@Title #PageTitle { @Text = ""; } }
  #Content {
    LayoutMode: Top;
    Padding: (Full: 24);
    Group {
      LayoutMode: LeftWrap;
      Anchor: (Bottom: 8);
      $C.@SecondaryTextButton #Back { @Text = ""; Anchor: (Width: 180, Right: 8, Height: 48); }
      $C.@SecondaryTextButton #Activities { @Text = ""; Anchor: (Width: 260, Right: 8, Height: 48); }
      DropdownBox #Filter { Anchor: (Width: 240, Right: 8, Height: 48); Style: @DeadlineStyle; Visible: false; }
      $C.@TextButton #New { @Text = ""; Anchor: (Width: 240, Height: 48); Visible: false; }
    }
    Label #Heading { Anchor: (Bottom: 12); Style: (FontSize: 24, TextColor: #ffffff, Wrap: true); }
    Label #Breadcrumb { Anchor: (Bottom: 12); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
    Group #CopyBanner { Visible: false; LayoutMode: LeftWrap; Anchor: (Bottom: 12);
      Label #CopyContext { FlexWeight: 1; Anchor: (MinWidth: 260, Right: 12, Bottom: 6); Style: (FontSize: 18, Wrap: true, TextColor: #efbb73); }
      $C.@CancelTextButton #Discard { @Text = ""; Anchor: (Width: 320, Height: 48, Bottom: 6); }
    }
    Group #CopyConfirm { Visible: false; LayoutMode: LeftWrap; Anchor: (Bottom: 12);
      Label #DiscardHelpLabel { Text: ""; FlexWeight: 1; Anchor: (MinWidth: 240, Right: 12); Style: (FontSize: 18, Wrap: true, TextColor: #efbb73); }
      $C.@CancelTextButton #ConfirmCopy { @Text = ""; Anchor: (Width: 260, Height: 48, Right: 8); }
      $C.@SecondaryTextButton #CancelCopy { @Text = ""; Anchor: (Width: 160, Height: 48); }
    }
    Group #Body {
      FlexWeight: 1;
      LayoutMode: Left;
      Group #ListPanel {
        FlexWeight: 1;
        Anchor: (MinWidth: 240, MaxWidth: 440, Right: 20);
        LayoutMode: Top;
        Group {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Label #Empty { Anchor: (Height: 70); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
          Group #Rows { LayoutMode: Top; }
        }
        Group #Pagination { LayoutMode: Top;
        Label #Page { Anchor: (Height: 24); Style: (FontSize: 16, HorizontalAlignment: Center, TextColor: #9daec2); }
        Group {
          LayoutMode: LeftWrap;
          $C.@SecondaryTextButton #Previous { @Text = ""; Anchor: (Width: 152, Right: 8, Bottom: 6, Height: 48); }
          $C.@SecondaryTextButton #Next { @Text = ""; Anchor: (Width: 152, Bottom: 6, Height: 48); }
        }
        }
      }
      Group #Details {
        FlexWeight: 3;
        Anchor: (MinWidth: 280);
        LayoutMode: Top;
        Group #EditorTabs { Visible: false; LayoutMode: LeftWrap; Anchor: (Bottom: 14);
          Group { LayoutMode: Top; Anchor: (Width: 230, Height: 48, Right: 8, Bottom: 6);
            $C.@SecondaryTextButton #SectionBasics { @Text = ""; Anchor: (Height: 48); }
            $C.@TextButton #SectionBasicsActive { @Text = ""; Anchor: (Height: 48); Visible: false; }
          }
          Group { LayoutMode: Top; Anchor: (Width: 230, Height: 48, Right: 8, Bottom: 6);
            $C.@SecondaryTextButton #SectionComponents { @Text = ""; Anchor: (Height: 48); }
            $C.@TextButton #SectionComponentsActive { @Text = ""; Anchor: (Height: 48); Visible: false; }
          }
          Group { LayoutMode: Top; Anchor: (Width: 250, Height: 48, Right: 8, Bottom: 6);
            $C.@SecondaryTextButton #SectionTable { @Text = ""; Anchor: (Height: 48); }
            $C.@TextButton #SectionTableActive { @Text = ""; Anchor: (Height: 48); Visible: false; }
          }
        }
        Group #DeleteDraftPrompt { Visible: false; LayoutMode: Top; Anchor: (Left: 0, MaxWidth: 900, Bottom: 12); Padding: (Full: 16); Background: (Color: #233047);
          Label #DeleteDraftContext { Anchor: (Bottom: 10); Style: (FontSize: 22, Wrap: true, TextColor: #ffffff); }
          Label #DeleteDraftWarning { Text: ""; Anchor: (Bottom: 8); Style: (FontSize: 19, Wrap: true, TextColor: #efbb73); }
          Group { LayoutMode: LeftWrap;
            $C.@CancelTextButton #ConfirmDeleteDraft { @Text = ""; Anchor: (Width: 260, Right: 8, Bottom: 6, Height: 48); }
            $C.@SecondaryTextButton #CancelDeleteDraft { @Text = ""; Anchor: (Width: 190, Bottom: 6, Height: 48); }
          }
        }
        Group #UnsavedPrompt { Visible: false; LayoutMode: Top; Anchor: (Left: 0, MaxWidth: 900, Bottom: 12); Padding: (Full: 16); Background: (Color: #233047);
          Label #UnsavedContext { Anchor: (Bottom: 10); Style: (FontSize: 22, Wrap: true, TextColor: #ffffff); }
          Label #UnsavedLabel { Text: ""; Anchor: (Bottom: 8); Style: (FontSize: 19, Wrap: true, TextColor: #efbb73); }
          Group { LayoutMode: LeftWrap;
            $C.@TextButton #SaveAndLeave { @Text = ""; Anchor: (Width: 260, Right: 8, Bottom: 6, Height: 48); }
            $C.@CancelTextButton #DiscardChanges { @Text = ""; Anchor: (Width: 260, Right: 8, Bottom: 6, Height: 48); }
            $C.@SecondaryTextButton #KeepEditing { @Text = ""; Anchor: (Width: 270, Bottom: 6, Height: 48); }
          }
        }
        Group #DetailsScroll {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group #CatalogOverview { Visible: false; LayoutMode: Top; Anchor: (Bottom: 16);
            Label #CatalogOverviewTitle { Text: ""; Anchor: (Bottom: 12); Style: (FontSize: 24, TextColor: #ffffff); }
            Group { LayoutMode: LeftWrap;
              Label #CatalogPublished { Anchor: (Width: 260, Height: 100, Right: 12, Bottom: 10); Padding: (Full: 14); Background: (Color: #233047); Style: (FontSize: 20, Wrap: true, TextColor: #c8d3e0); }
              Label #CatalogDrafts { Anchor: (Width: 260, Height: 100, Right: 12, Bottom: 10); Padding: (Full: 14); Background: (Color: #233047); Style: (FontSize: 20, Wrap: true, TextColor: #c8d3e0); }
              Label #CatalogPending { Anchor: (Width: 260, Height: 100, Bottom: 10); Padding: (Full: 14); Background: (Color: #233047); Style: (FontSize: 20, Wrap: true, TextColor: #c8d3e0); }
            }
            Label #CatalogHint { Anchor: (Bottom: 12); Style: (FontSize: 19, Wrap: true, TextColor: #9daec2); }
          }
          Group #Editor {
            Visible: false;
            LayoutMode: Top;

            Label #EditorError { Visible: false; Anchor: (Bottom: 12); Style: (FontSize: 18, Wrap: true, TextColor: #efbb73); }
            Group #BasicsPanel { LayoutMode: Top;
            Label #TitleLabel { Anchor: (Bottom: 4); Text: ""; Style: (FontSize: 19, Wrap: true, TextColor: #ffffff); }
            $C.@TextField #TitleField { Anchor: (Bottom: 8, Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 128; }
            Label #DeadlineLabel { Anchor: (Bottom: 4); Text: ""; Style: (FontSize: 18, Wrap: true, TextColor: #ffffff); }
            Group #DeadlineControls {
              LayoutMode: LeftWrap;
              Group {
                LayoutMode: Top;
                Anchor: (Width: 100, Right: 12, Bottom: 12);
                Label #DayLabel { Text: ""; Style: (FontSize: 18, TextColor: #9daec2); Anchor: (Bottom: 4); }
                DropdownBox #DeadlineDay { Anchor: (Height: 44); Style: @DeadlineStyle; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 180, Right: 12, Bottom: 12);
                Label #MonthLabel { Text: ""; Style: (FontSize: 18, TextColor: #9daec2); Anchor: (Bottom: 4); }
                DropdownBox #DeadlineMonth { Anchor: (Height: 44); Style: @DeadlineStyle; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 130, Right: 12, Bottom: 12);
                Label #YearLabel { Text: ""; Style: (FontSize: 18, TextColor: #9daec2); Anchor: (Bottom: 4); }
                DropdownBox #DeadlineYear { Anchor: (Height: 44); Style: @DeadlineStyle; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 100, Right: 12, Bottom: 12);
                Label #HourLabel { Text: ""; Style: (FontSize: 18, TextColor: #9daec2); Anchor: (Bottom: 4); }
                DropdownBox #DeadlineHour { Anchor: (Height: 44); Style: @DeadlineStyle; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 100, Right: 12, Bottom: 12);
                Label #MinuteLabel { Text: ""; Style: (FontSize: 18, TextColor: #9daec2); Anchor: (Bottom: 4); }
                DropdownBox #DeadlineMinute { Anchor: (Height: 44); Style: @DeadlineStyle; }
              }
            }
            Group { LayoutMode: Left; Anchor: (Bottom: 12);
              Group { LayoutMode: Top; Anchor: (Width: 220);
                Label #ValueLabel { Anchor: (Bottom: 4); Text: ""; Style: (FontSize: 19, Wrap: true, TextColor: #ffffff); }
                $C.@TextField #ValueField { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 16; }
              }
            }
            Label #DescriptionLabel { Anchor: (Bottom: 4); Text: ""; Style: (FontSize: 19, Wrap: true, TextColor: #ffffff); }
            $C.@MultilineTextField #DescriptionField { Anchor: (Height: 200, Bottom: 8); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 8192; }
            }
            Group #ComponentsPanel { Visible: false; LayoutMode: Top;
            Label #RequirementsLabel { Anchor: (Top: 8, Bottom: 6); Text: ""; Style: (FontSize: 20, Wrap: true, TextColor: #ffffff); }
            Label #RequirementsHelpLabel { Anchor: (Bottom: 10); Text: ""; Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
            Group {
              LayoutMode: LeftWrap;
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label #ModuleLeverLabel { Text: ""; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredLEVER { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label #ModuleCableLabel { Text: ""; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredCABLE { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label #ModuleLampLabel { Text: ""; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredLAMP { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
            }
            Group { LayoutMode: LeftWrap; Anchor: (Left: 0, MaxWidth: 1000);
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "AND"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredAND { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "OR"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredOR { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "NOT"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredNOT { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "NAND"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredNAND { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "NOR"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredNOR { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "XOR"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredXOR { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
              Group {
                LayoutMode: Top;
                Anchor: (Width: 190, Right: 12, Bottom: 12);
                Label { Text: "XNOR"; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #c8d3e0); }
                $C.@TextField #RequiredXNOR { Anchor: (Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 5; }
              }
            }
            }
            Group #TablePanel { Visible: false; LayoutMode: Top;
              Label #ExpectedTableLabel { Text: ""; Anchor: (Bottom: 8); Style: (FontSize: 22, Wrap: true, TextColor: #ffffff); }
              Label #IntroLabel { Text: ""; Anchor: (Bottom: 12); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
              Group { LayoutMode: LeftWrap; Anchor: (Bottom: 10);
                $C.@SecondaryTextButton #TruthToggle { @Text = ""; Anchor: (Width: 290, Right: 8, Bottom: 6, Height: 48); }
                $C.@SecondaryTextButton #TruthHelp { @Text = ""; Anchor: (Width: 200, Bottom: 6, Height: 48); }
              }
              Label #TruthHelpText { Visible: false; Text: ""; Anchor: (Bottom: 12); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
              Group #TruthConfig { Visible: false; LayoutMode: Top;
                Group { LayoutMode: LeftWrap; Anchor: (Bottom: 10);
                  Group { LayoutMode: Top; Anchor: (Width: 180, Right: 12, Bottom: 6);
                    Label #InputsLabel { Text: ""; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #ffffff); }
                    DropdownBox #TruthInputs { Anchor: (Height: 42); Style: @DeadlineStyle; }
                  }
                  Group { LayoutMode: Top; Anchor: (Width: 180, Right: 12, Bottom: 6);
                    Label #OutputsLabel { Text: ""; Anchor: (Bottom: 4); Style: (FontSize: 18, TextColor: #ffffff); }
                    DropdownBox #TruthOutputs { Anchor: (Height: 42); Style: @DeadlineStyle; }
                  }
                  $C.@SecondaryTextButton #TruthAnd { @Text = ""; Anchor: (Width: 210, Right: 8, Bottom: 6, Height: 48); }
                  $C.@SecondaryTextButton #TruthMode { @Text = ""; Anchor: (Width: 230, Bottom: 6, Height: 48); }
                }
                Label #TruthCompletion { Anchor: (Bottom: 10); Style: (FontSize: 18, Wrap: true, TextColor: #7cb7ee); }
                Group #TruthGrid { LayoutMode: Top;
                  Label #LegendLabel { Text: ""; Anchor: (Bottom: 10); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
                  Group #TruthRows { LayoutMode: Top; }
                  Group #TruthPages { LayoutMode: LeftWrap; Anchor: (Top: 8);
                    $C.@SecondaryTextButton #TruthPrevious { @Text = ""; Anchor: (Width: 152, Right: 8, Bottom: 6, Height: 48); }
                    Label #TruthPage { Anchor: (Width: 140, Height: 48, Right: 8); Style: (FontSize: 16, VerticalAlignment: Center, TextColor: #9daec2); }
                    $C.@SecondaryTextButton #TruthNext { @Text = ""; Anchor: (Width: 152, Bottom: 6, Height: 48); }
                  }
                }
                Group #TruthAdvanced { Visible: false; LayoutMode: Top;
                  Label #TableHelpLabel { Text: ""; Anchor: (Bottom: 10); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
                  $C.@MultilineTextField #TruthTableField { Anchor: (Height: 220, Bottom: 12); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 4096; }
                }
              }
              Group #TruthConfirm { Visible: false; LayoutMode: Top; Anchor: (Top: 12);
                Label #ReplaceHelpLabel { Text: ""; Anchor: (Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #efbb73); }
                Group { LayoutMode: LeftWrap;
                  $C.@CancelTextButton #TruthConfirmChange { @Text = ""; Anchor: (Width: 260, Right: 8, Height: 48); }
                  $C.@SecondaryTextButton #TruthCancelChange { @Text = ""; Anchor: (Width: 180, Height: 48); }
                }
              }
            }
          }
          Group #Read {
            Visible: false;
            LayoutMode: Top;
            Group {
              LayoutMode: LeftWrap;
              Anchor: (Bottom: 12);
              Label #ReadTitle { FlexWeight: 1; Anchor: (MinWidth: 200, Right: 12, Bottom: 8); Style: (FontSize: 28, Wrap: true, TextColor: #ffffff); }
              $C.@TextButton #Edit { @Text = ""; Anchor: (Width: 260, Height: 48, Bottom: 8); Visible: false; }
            }
            Label #ReadState { Anchor: (Bottom: 8); Style: (FontSize: 19, Wrap: true, TextColor: #7cb7ee); }
            Label #StudentInfo { Anchor: (Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            Label #ReadMeta { Anchor: (Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
            Label #DraftNotice { Anchor: (Bottom: 12); Style: (FontSize: 19, Wrap: true, TextColor: #efbb73); Visible: false; }
            Label #DeadlineState { Anchor: (Bottom: 8); Text: ""; Style: (FontSize: 18, Wrap: true, TextColor: #efbb73); Visible: false; }
            Group #Statement { LayoutMode: Top;
            Label #ReadDescription { Anchor: (Bottom: 8); Style: (FontSize: 19, Wrap: true, TextColor: #c8d3e0); }
            Label #ReadRequirements { Anchor: (Top: 8, Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            Label #ReadTable { Anchor: (Bottom: 12); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            }
            Label #ActivityScore { Anchor: (Bottom: 8); Style: (FontSize: 19, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            Label #NoSubmission { Anchor: (Bottom: 8); Text: ""; Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); Visible: false; }
          }
          Group #Submission {
            Visible: false;
            LayoutMode: Top;
            Label #VersionSnapshot { Anchor: (Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            Label #SubmissionRules { Anchor: (Bottom: 12); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            Label #VerificationResults { Anchor: (Bottom: 16); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); Visible: false; }
            Label #SubmissionMeta { Anchor: (Bottom: 6); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
            Group #ReviewColumns { LayoutMode: LeftWrap;
            Group #PreviewPanel { LayoutMode: Top; FlexWeight: 2; Anchor: (MinWidth: 300, Right: 16);
            PrefabPreviewComponent #PrefabPreview { Anchor: (Height: 360, Bottom: 16); AllowDragYaw: true; AllowDragPitch: true; AllowZoom: true; AllowPan: true; ShowAnchor: true; }
            }
            Group #AssessmentPanel { LayoutMode: Top; FlexWeight: 1; Anchor: (MinWidth: 260, MaxWidth: 480);
            Label #Assessment { Anchor: (Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
            Label #FeedbackText { Anchor: (Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
            Group #GradeEditor {
              Visible: false;
              LayoutMode: Top;
              Label #ScoreLabel { Anchor: (Bottom: 4); Text: ""; Style: (FontSize: 19, Wrap: true, TextColor: #ffffff); }
              Group { LayoutMode: Left; Anchor: (Bottom: 12);
                $C.@TextField #ScoreField { Anchor: (Width: 180, Right: 8, Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 16; }
                Label #GradeMaximum { Anchor: (Width: 110, Height: 46); Style: (FontSize: 19, VerticalAlignment: Center, TextColor: #9daec2); }
              }
              Label #FeedbackLabel { Anchor: (Bottom: 4); Text: ""; Style: (FontSize: 19, Wrap: true, TextColor: #ffffff); }
              $C.@MultilineTextField #FeedbackField { Anchor: (Height: 160, Bottom: 8); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 4096; }
            }
            }
            }
          }
        }
        Group #ActionDock {
          LayoutMode: Top;
          Anchor: (Top: 8);
          Group { LayoutMode: LeftWrap;
            $C.@SecondaryTextButton #ShowStatement { @Text = ""; Anchor: (Width: 270, Right: 8, Bottom: 6, Height: 48); Visible: false; }
            $C.@SecondaryTextButton #ShowSubmission { @Text = ""; Anchor: (Width: 240, Bottom: 6, Height: 48); Visible: false; }
          }
          Label #SelectionNotice { Visible: false; Anchor: (Bottom: 10); Style: (FontSize: 19, Wrap: true, TextColor: #efbb73); }
          Group #ActivityActions {
            LayoutMode: LeftWrap;
            Anchor: (Bottom: 6);
            Visible: false;
            $C.@TextButton #SaveDraft { @Text = ""; Anchor: (Width: 250, Right: 8, Bottom: 6, Height: 48); }
            $C.@TextButton #Publish { @Text = ""; Anchor: (Width: 160, Right: 8, Bottom: 6, Height: 48); }
            $C.@SecondaryTextButton #CancelEdit { @Text = ""; Anchor: (Width: 280, Bottom: 6, Height: 48); Visible: false; }
          }
          Group #CatalogActions {
            LayoutMode: LeftWrap;
            Anchor: (Bottom: 6);
            Visible: false;
            $C.@SecondaryTextButton #Archive { @Text = ""; Anchor: (Width: 190, Right: 8, Bottom: 6, Height: 48); Visible: false; }
            $C.@SecondaryTextButton #Restore { @Text = ""; Anchor: (Width: 190, Right: 8, Bottom: 6, Height: 48); Visible: false; }
            $C.@CancelTextButton #DeleteDraft { @Text = ""; Anchor: (Width: 250, Bottom: 6, Height: 48); Visible: false; }
          }
          $C.@SecondaryTextButton #Students { @Text = ""; Anchor: (Bottom: 6, Height: 48); Visible: false; }
          $C.@TextButton #Deliver { @Text = ""; Anchor: (Bottom: 6, Height: 48); Visible: false; }
          $C.@TextButton #SubmitArea { @Text = ""; Anchor: (Bottom: 6, Height: 48); Visible: false; }
          $C.@SecondaryTextButton #CancelSelection { @Text = ""; Anchor: (Bottom: 6, Height: 48); Visible: false; }
          Group #RevisionActions {
            Visible: false;
            LayoutMode: LeftWrap;
            Anchor: (Bottom: 6);
            $C.@SecondaryTextButton #Newer { @Text = ""; Anchor: (Width: 240, Right: 8, Bottom: 6, Height: 48); }
            $C.@SecondaryTextButton #Older { @Text = ""; Anchor: (Width: 240, Bottom: 6, Height: 48); }
          }
          Group #ReviewActions {
            Visible: false;
            LayoutMode: LeftWrap;
            Anchor: (Bottom: 6);
            $C.@SecondaryTextButton #Verify { @Text = ""; Anchor: (Width: 260, Right: 8, Bottom: 6, Height: 48); Visible: false; }
            $C.@TextButton #SaveGrade { @Text = ""; Anchor: (Width: 250, Right: 8, Bottom: 6, Height: 48); }
            $C.@SecondaryTextButton #Paste { @Text = ""; Anchor: (Width: 240, Right: 8, Bottom: 6, Height: 48); }
          }

        }
      }
    }

    Label #Status { Anchor: (Top: 12, Bottom: 12); Text: ""; Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
    Group {
      LayoutMode: Top;
      Group {
        LayoutMode: LeftWrap;
        $C.@SecondaryTextButton #Reload { @Text = ""; Anchor: (Width: 180, Right: 8, Height: 48); }
        $C.@CancelTextButton #Close { @Text = ""; Anchor: (Width: 156, Right: 12, Height: 48); }
      }
      Label #Build { Anchor: (Top: 6); Style: (FontSize: 12, Wrap: true, TextColor: #9daec2); }
    }
  }
}
