$C = "../../Common.ui";

$C.@PageOverlay {}
$C.@Container {
  Anchor: (Full: 16);
  #Title { $C.@Title #PageTitle { @Text = ""; } }
  #Content {
    LayoutMode: Top;
    Padding: (Full: 24);
    Group #Navigation {
      LayoutMode: LeftWrap;
      Anchor: (Bottom: 8);
      $C.@SecondaryTextButton #NavClass { @Text = ""; Anchor: (Width: 240, Right: 8, Height: 48); }
      $C.@SecondaryTextButton #Activities { @Text = ""; Anchor: (Width: 190, Right: 8, Height: 48); Visible: false; }
      $C.@SecondaryTextButton #NavIntakes { @Text = ""; Anchor: (Width: 240, Right: 8, Height: 48); }
      $C.@SecondaryTextButton #NavInvite { @Text = ""; Anchor: (Width: 240, Right: 8, Height: 48); Visible: false; }
      $C.@SecondaryTextButton #NavSettings { @Text = ""; Anchor: (Width: 240, Height: 48); Visible: false; }
    }
    Label #HeaderTitle { Anchor: (Bottom: 4); Text: ""; Style: (FontSize: 28, Wrap: true, TextColor: #ffffff); }
    Label #HeaderInfo { Anchor: (Bottom: 10); Text: ""; Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
    Group #Body {
      FlexWeight: 1;
      Anchor: (Bottom: 12);
      LayoutMode: Left;
      Group #ListPanel {
        Visible: false;
        FlexWeight: 1;
        Anchor: (MinWidth: 240, MaxWidth: 440, Right: 20);
        LayoutMode: Top;
        Group #SearchBar {
          LayoutMode: Left;
          Anchor: (Height: 48, Bottom: 12);
          $C.@TextField #Search { Anchor: (Right: 8, Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); FlexWeight: 1; MaxLength: 128; }
          $C.@SecondaryTextButton #Find { @Text = ""; Anchor: (Width: 120, Height: 48); }
        }
        Label #Empty { Anchor: (Height: 64); Text: ""; Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
        Group {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group #Rows { LayoutMode: Top; }
        }
        Group #Pagination {
          Anchor: (Top: 12);
          LayoutMode: Top;
          Label #Page { Anchor: (Height: 24, Bottom: 6); Style: (FontSize: 16, HorizontalAlignment: Center, VerticalAlignment: Center, TextColor: #c8d3e0); }
          Group {
            LayoutMode: LeftWrap;
            $C.@SecondaryTextButton #Previous { @Text = ""; Anchor: (Width: 152, Right: 8, Bottom: 6, Height: 48); }
            $C.@SecondaryTextButton #Next { @Text = ""; Anchor: (Width: 152, Bottom: 6, Height: 48); }
          }
        }
      }
      Group #Details {
        FlexWeight: 3;
        Anchor: (MinWidth: 280);
        LayoutMode: Top;
        Group #DetailsScroll {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group #Overview {
            Visible: false;
            LayoutMode: Top;
            Anchor: (Bottom: 20);
            Label #OverviewTitle { Text: ""; Anchor: (Bottom: 10); Style: (FontSize: 22, TextColor: #ffffff); }
            Group #OverviewCards {
              LayoutMode: LeftWrap;
              Label #SummaryPublished { Anchor: (Width: 260, Height: 100, Right: 12, Bottom: 10); Padding: (Full: 14); Background: (Color: #233047); Style: (FontSize: 20, Wrap: true, TextColor: #c8d3e0); }
              Label #SummaryDelivered { Anchor: (Width: 260, Height: 100, Right: 12, Bottom: 10); Padding: (Full: 14); Background: (Color: #233047); Style: (FontSize: 20, Wrap: true, TextColor: #c8d3e0); }
              Label #SummaryPending { Anchor: (Width: 260, Height: 100, Bottom: 10); Padding: (Full: 14); Background: (Color: #233047); Style: (FontSize: 20, Wrap: true, TextColor: #c8d3e0); }
            }
            Label #OverviewHint { Anchor: (Bottom: 8); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
          }
          Group #View {
            LayoutMode: Top;
            Label #DetailTitle { Anchor: (Bottom: 8); Style: (FontSize: 28, Wrap: true, TextColor: #ffffff); }
            Label #ProfileProgress { Visible: false; Anchor: (Bottom: 12); Style: (FontSize: 20, Wrap: true, TextColor: #7cb7ee); }
            Label #MetaTeacher { Visible: false; Anchor: (Bottom: 4); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
            Label #MetaState { Visible: false; Anchor: (Bottom: 4); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
            Label #MetaEnrollment { Visible: false; Anchor: (Bottom: 4); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
            Label #MetaDate { Visible: false; Anchor: (Bottom: 4); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
            Label #MetaType { Visible: false; Anchor: (Bottom: 4); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
            Label #MetaUuid { Visible: false; Anchor: (Bottom: 4); Style: (FontSize: 12, Wrap: true, TextColor: #9daec2); }
            Group #DescriptionDisplay {
              LayoutMode: Top;
              Anchor: (Top: 8);
              Label #DescriptionLabel { Anchor: (Bottom: 6); Text: ""; Style: (FontSize: 19, TextColor: #ffffff); }
              Label #DescriptionText { Anchor: (Bottom: 12); Style: (FontSize: 19, Wrap: true, TextColor: #c8d3e0); }
            }
            Group #MessageDisplay {
              Visible: false;
              LayoutMode: Top;
              Label #MessageLabel { Anchor: (Bottom: 6); Text: ""; Style: (FontSize: 19, TextColor: #ffffff); }
              Label #MessageText { Anchor: (Bottom: 12); Style: (FontSize: 19, Wrap: true, TextColor: #c8d3e0); }
            }
          }
          Group #ContextActions { LayoutMode: LeftWrap; Anchor: (Bottom: 10);
            $C.@SecondaryTextButton #Technical { @Text = ""; Anchor: (Width: 210, Bottom: 6, Height: 48); Visible: false; }
          }
          Group #StudentActivities {
            Visible: false;
            LayoutMode: Top;
            Anchor: (Top: 16);
            Label #StudentActivitiesLabel { Text: ""; Anchor: (Bottom: 10); Style: (FontSize: 22, Wrap: true, TextColor: #ffffff); }
            Label #StudentActivitiesEmpty { Text: ""; Anchor: (Bottom: 10); Style: (FontSize: 18, Wrap: true, TextColor: #9daec2); }
            Group #StudentActivityRows { LayoutMode: Top; }
          }
          Group #Form {
            Visible: false;
            Anchor: (Left: 0, MaxWidth: 1200);
            LayoutMode: Top;
            Label #NameLabel { Anchor: (Bottom: 6); Text: ""; Style: (FontSize: 18, Wrap: true, TextColor: #ffffff); }
            $C.@TextField #Name { Anchor: (Bottom: 12, Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 64; }
            Label #DescriptionLabel2 { Anchor: (Bottom: 6); Text: ""; Style: (FontSize: 18, Wrap: true, TextColor: #ffffff); }
            $C.@MultilineTextField #Description { Anchor: (Height: 200, Bottom: 12); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 2048; }
            Group #MessageEditor {
              Visible: false;
              LayoutMode: Top;
              Label #MessageLabel2 { Anchor: (Bottom: 6); Text: ""; Style: (FontSize: 18, Wrap: true, TextColor: #ffffff); }
              $C.@MultilineTextField #Message { Anchor: (Height: 200, Bottom: 12); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 2048; }
            }
          }
          Label #NoAccess { Visible: false; Anchor: (Height: 110); Text: ""; Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
        }
        Group #ActionDock {
          LayoutMode: Top;
          Anchor: (Top: 8);
          Group #StudentPages {
            Visible: false;
            LayoutMode: LeftWrap;
            $C.@SecondaryTextButton #ActivityPrevious { @Text = ""; Anchor: (Width: 152, Right: 8, Bottom: 6, Height: 48); }
            Label #ActivityPage { Anchor: (Width: 130, Height: 48, Right: 8); Style: (FontSize: 16, HorizontalAlignment: Center, VerticalAlignment: Center, TextColor: #9daec2); }
            $C.@SecondaryTextButton #ActivityNext { @Text = ""; Anchor: (Width: 152, Bottom: 6, Height: 48); }
          }
          Group {
            LayoutMode: LeftWrap;
            $C.@SecondaryTextButton #ManageMember { @Text = ""; Anchor: (Width: 270, Right: 8, Bottom: 6, Height: 48); Visible: false; }
          }
          Group #EnrollmentForm {
            Visible: false;
            LayoutMode: Top;
            Label #EnrollmentLabel { Anchor: (Bottom: 6); Text: ""; Style: (FontSize: 19, TextColor: #ffffff); }
            $C.@TextField #Enrollment { Anchor: (Bottom: 8, Height: 46); Style: (...$C.@DefaultInputFieldStyle, FontSize: 18); MaxLength: 64; }
          }
          Group #Actions {
            LayoutMode: Top;
            $C.@TextButton #Primary { @Text = ""; Anchor: (Bottom: 6, Height: 48); Visible: false; }
            $C.@SecondaryTextButton #Secondary { @Text = ""; Anchor: (Bottom: 6, Height: 48); Visible: false; }
            $C.@CancelTextButton #Danger { @Text = ""; Anchor: (Width: 320, Left: 0, Bottom: 6, Height: 48); Visible: false; }
            $C.@SecondaryTextButton #CancelConfirm { @Text = ""; Anchor: (Bottom: 6, Height: 48); Visible: false; }
          }
          Group #SettingsActions {
            LayoutMode: LeftWrap;
            Visible: false;
            $C.@TextButton #Save { @Text = ""; Anchor: (Width: 250, Right: 8, Bottom: 6, Height: 48); Visible: false; Disabled: true; }
            $C.@CancelTextButton #Disband { @Text = ""; Anchor: (Width: 250, Bottom: 6, Height: 48); Visible: false; }
            $C.@CancelTextButton #ConfirmDisband { @Text = ""; Anchor: (Width: 420, Right: 8, Bottom: 6, Height: 48); Visible: false; }
            $C.@SecondaryTextButton #CancelDisband { @Text = ""; Anchor: (Width: 200, Bottom: 6, Height: 48); Visible: false; }
          }
        }
      }
    }
    Label #Status { Anchor: (Top: 8, Bottom: 12); Text: ""; Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
    Group {
      LayoutMode: Top;
      Group {
        LayoutMode: LeftWrap;
        $C.@SecondaryTextButton #Reload { @Text = ""; Anchor: (Width: 180, Right: 10, Height: 48); }
        $C.@CancelTextButton #Close { @Text = ""; Anchor: (Width: 156, Right: 12, Height: 48); }
      }
      Label #Build { Anchor: (Top: 6); Style: (FontSize: 12, Wrap: true, TextColor: #9daec2); }
    }
  }
}
