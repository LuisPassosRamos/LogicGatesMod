$C = "../../Common.ui";

$C.@PageOverlay {}
$C.@Container {
  Anchor: (Width: 960, Height: 680);
  #Title { $C.@Title { @Text = %server.logicgates.classroom.title; } }
  #Content {
    LayoutMode: Top;
    Padding: (Full: 20);
    Group #Navigation {
      LayoutMode: Left;
      Anchor: (Height: 40, Bottom: 8);
      $C.@SecondaryTextButton #NavClass { @Anchor = (Width: 210, Right: 8); @Text = %server.logicgates.classroom.nav.class; }
      $C.@SecondaryTextButton #NavIntakes { @Anchor = (Width: 210, Right: 8); @Text = %server.logicgates.classroom.nav.intakes; }
      $C.@SecondaryTextButton #NavInvite { @Anchor = (Width: 210, Right: 8); @Text = %server.logicgates.classroom.invite; Visible: false; }
      $C.@SecondaryTextButton #NavSettings { @Anchor = (Width: 210); @Text = %server.logicgates.classroom.nav.settings; Visible: false; }
    }
    Label #HeaderTitle { Anchor: (Height: 34, Bottom: 4); Text: %server.logicgates.classroom.title; Style: (FontSize: 24, Wrap: true, TextColor: #ffffff); }
    Label #HeaderInfo { Anchor: (Height: 40, Bottom: 10); Text: %server.logicgates.classroom.oneClass; Style: (FontSize: 15, Wrap: true, TextColor: #9daec2); }
    Group #Body {
      FlexWeight: 1;
      Anchor: (Bottom: 12);
      LayoutMode: Left;
      Group #ListPanel {
        Visible: false;
        Anchor: (Width: 285, Right: 20);
        LayoutMode: Top;
        Group #SearchBar {
          LayoutMode: Left;
          Anchor: (Height: 38, Bottom: 8);
          $C.@TextField #Search { @Anchor = (Right: 8); FlexWeight: 1; MaxLength: 128; }
          $C.@SecondaryTextButton #Find { @Anchor = (Width: 120); @Text = %server.logicgates.classroom.find; }
        }
        Label #Empty { Anchor: (Height: 64); Text: %server.logicgates.classroom.emptyList; Style: (FontSize: 16, Wrap: true, TextColor: #9daec2); }
        Group {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group #Rows { LayoutMode: Top; }
        }
        Group #Pagination {
          Anchor: (Height: 70, Top: 8);
          LayoutMode: Top;
          Label #Page { Anchor: (Height: 24, Bottom: 6); Style: (FontSize: 14, HorizontalAlignment: Center, VerticalAlignment: Center, TextColor: #c8d3e0); }
          Group {
            Anchor: (Height: 40);
            LayoutMode: Left;
            $C.@SecondaryTextButton #Previous { @Anchor = (Width: 138, Right: 8); @Text = %server.logicgates.classroom.previous; }
            $C.@SecondaryTextButton #Next { @Text = %server.logicgates.classroom.next; FlexWeight: 1; }
          }
        }
      }
      Group #Details {
        FlexWeight: 1;
        LayoutMode: Top;
        Group #DetailsScroll {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group #View {
            LayoutMode: Top;
            Label #DetailTitle { Anchor: (Height: 32, Bottom: 8); Style: (FontSize: 22, Wrap: true, TextColor: #ffffff); }
            Label #MetaTeacher { Visible: false; Anchor: (Height: 24, Bottom: 4); Style: (FontSize: 15, Wrap: true, TextColor: #9daec2); }
            Label #MetaState { Visible: false; Anchor: (Height: 24, Bottom: 4); Style: (FontSize: 15, Wrap: true, TextColor: #9daec2); }
            Label #MetaEnrollment { Visible: false; Anchor: (Height: 24, Bottom: 4); Style: (FontSize: 15, Wrap: true, TextColor: #9daec2); }
            Label #MetaDate { Visible: false; Anchor: (Height: 24, Bottom: 4); Style: (FontSize: 15, Wrap: true, TextColor: #9daec2); }
            Label #MetaType { Visible: false; Anchor: (Height: 24, Bottom: 4); Style: (FontSize: 15, Wrap: true, TextColor: #9daec2); }
            Label #MetaUuid { Visible: false; Anchor: (Height: 24, Bottom: 4); Style: (FontSize: 12, Wrap: true, TextColor: #9daec2); }
            Group #DescriptionDisplay {
              LayoutMode: Top;
              Anchor: (Top: 8);
              Label { Anchor: (Height: 24, Bottom: 4); Text: %server.logicgates.classroom.description; Style: (FontSize: 17, TextColor: #ffffff); }
              Label #DescriptionText { Anchor: (Height: 24, Bottom: 12); Style: (FontSize: 17, Wrap: true, TextColor: #c8d3e0); }
            }
            Group #MessageDisplay {
              Visible: false;
              LayoutMode: Top;
              Label { Anchor: (Height: 24, Bottom: 4); Text: %server.logicgates.classroom.message; Style: (FontSize: 17, TextColor: #ffffff); }
              Label #MessageText { Anchor: (Height: 24, Bottom: 12); Style: (FontSize: 17, Wrap: true, TextColor: #c8d3e0); }
            }
          }
          Group #Form {
            Visible: false;
            LayoutMode: Top;
            Label { Anchor: (Height: 24, Bottom: 4); Text: %server.logicgates.classroom.name; Style: (FontSize: 18, TextColor: #ffffff); }
            $C.@TextField #Name { @Anchor = (Bottom: 12); MaxLength: 64; }
            Label { Anchor: (Height: 24, Bottom: 4); Text: %server.logicgates.classroom.description; Style: (FontSize: 18, TextColor: #ffffff); }
            $C.@MultilineTextField #Description { @Anchor = (Height: 130, Bottom: 12); MaxLength: 2048; }
            Group #MessageEditor {
              Visible: false;
              LayoutMode: Top;
              Label { Anchor: (Height: 24, Bottom: 4); Text: %server.logicgates.classroom.message; Style: (FontSize: 18, TextColor: #ffffff); }
              $C.@MultilineTextField #Message { @Anchor = (Height: 130, Bottom: 12); MaxLength: 2048; }
            }
          }
          Label #NoAccess { Visible: false; Anchor: (Height: 110); Text: %server.logicgates.classroom.noAccess; Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
        }
        Group #ActionDock {
          LayoutMode: Top;
          Anchor: (Top: 8);
          Group #EnrollmentForm {
            Visible: false;
            LayoutMode: Top;
            Label { Anchor: (Height: 24, Bottom: 4); Text: %server.logicgates.classroom.enrollment; Style: (FontSize: 17, TextColor: #ffffff); }
            $C.@TextField #Enrollment { @Anchor = (Bottom: 8); MaxLength: 64; }
          }
          Group #Actions {
            LayoutMode: Top;
            $C.@TextButton #Primary { @Anchor = (Bottom: 6); @Text = %server.logicgates.classroom.request; Visible: false; }
            $C.@SecondaryTextButton #Secondary { @Anchor = (Bottom: 6); @Text = %server.logicgates.classroom.cancel; Visible: false; }
            $C.@CancelTextButton #Danger { @Anchor = (Bottom: 6); @Text = %server.logicgates.classroom.remove; Visible: false; }
            $C.@SecondaryTextButton #CancelConfirm { @Anchor = (Bottom: 6); @Text = %server.logicgates.classroom.cancel; Visible: false; }
          }
          $C.@TextButton #Save { @Anchor = (Width: 250); @Text = %server.logicgates.classroom.save; Visible: false; Disabled: true; }
        }
      }
    }
    Label #Status { Anchor: (Height: 42, Bottom: 8); Text: %server.logicgates.classroom.loading; Style: (FontSize: 16, Wrap: true, TextColor: #c8d3e0); }
    Group {
      LayoutMode: Left;
      Anchor: (Height: 40);
      $C.@SecondaryTextButton #Reload { @Anchor = (Width: 160, Right: 10); @Text = %server.logicgates.classroom.reload; }
      $C.@CancelTextButton #Close { @Anchor = (Width: 130, Right: 12); @Text = %server.logicgates.classroom.probe.close; }
      $C.@SecondaryTextButton #Activities { @Anchor = (Width: 150, Right: 12); @Text = %server.logicgates.learning.activities; Visible: false; }
      Label #Build { FlexWeight: 1; Style: (FontSize: 12, Wrap: true, TextColor: #9daec2); }
    }
  }
}
