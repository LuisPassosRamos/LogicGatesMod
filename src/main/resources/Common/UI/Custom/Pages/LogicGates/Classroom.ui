$C = "../../Common.ui";

$C.@PageOverlay {}
$C.@Container {
  Anchor: (Width: 960, Height: 680);
  #Title { $C.@Title { @Text = %server.logicgates.classroom.title; } }
  #Content {
    LayoutMode: Top;
    Padding: (Full: 20);
    Group #Navigation {
      LayoutMode: Left;
      Anchor: (Height: 38, Bottom: 10);
      $C.@SecondaryTextButton #NavClass { @Anchor = (Width: 210, Right: 8); @Text = %server.logicgates.classroom.nav.class; }
      $C.@SecondaryTextButton #NavIntakes { @Anchor = (Width: 210, Right: 8); @Text = %server.logicgates.classroom.nav.intakes; }
      $C.@SecondaryTextButton #NavInvite { @Anchor = (Width: 210, Right: 8); @Text = %server.logicgates.classroom.invite; Visible: false; }
      $C.@SecondaryTextButton #NavSettings { @Anchor = (Width: 210); @Text = %server.logicgates.classroom.nav.settings; Visible: false; }
    }
    Label #HeaderTitle { Anchor: (Height: 34); Text: %server.logicgates.classroom.title; Style: (FontSize: 24, Wrap: true, TextColor: #ffffff); }
    Label #HeaderInfo { Anchor: (Height: 40, Bottom: 10); Text: %server.logicgates.classroom.oneClass; Style: (FontSize: 15, Wrap: true, TextColor: #9daec2); }
    Group #Body {
      FlexWeight: 1;
      Anchor: (Bottom: 12);
      LayoutMode: Left;
      Group #ListPanel {
        Visible: false;
        Anchor: (Width: 285, Right: 20);
        LayoutMode: Top;
        Group #SearchBar {
          LayoutMode: Left;
          Anchor: (Height: 38, Bottom: 8);
          $C.@TextField #Search { @Anchor = (Width: 180, Right: 8); MaxLength: 128; }
          $C.@SecondaryTextButton #Find { @Anchor = (Width: 95); @Text = %server.logicgates.classroom.find; }
        }
        Label #Empty { Anchor: (Height: 64); Text: %server.logicgates.classroom.emptyList; Style: (FontSize: 16, Wrap: true, TextColor: #9daec2); }
        Group {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group #Rows { LayoutMode: Top; }
        }
        Group #Pagination {
          Anchor: (Height: 34, Top: 8);
          LayoutMode: Left;
          $C.@SecondaryTextButton #Previous { @Anchor = (Width: 70, Right: 6); @Text = %server.logicgates.classroom.previous; }
          Label #Page { FlexWeight: 1; Style: (FontSize: 14, HorizontalAlignment: Center, VerticalAlignment: Center, TextColor: #c8d3e0); }
          $C.@SecondaryTextButton #Next { @Anchor = (Width: 70); @Text = %server.logicgates.classroom.next; }
        }
      }
      Group #Details {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Label #DetailTitle { Anchor: (Height: 64, Bottom: 8); Style: (FontSize: 22, Wrap: true, TextColor: #ffffff); }
        Label #DetailMeta { Anchor: (Height: 100, Bottom: 8); Style: (FontSize: 15, Wrap: true, TextColor: #9daec2); }
        Label #DescriptionText { Anchor: (Height: 80, Bottom: 12); Style: (FontSize: 17, Wrap: true, TextColor: #c8d3e0); }
        Group #MessageDisplay {
          Visible: false;
          LayoutMode: Top;
          Label { Anchor: (Height: 28, Bottom: 8); Text: %server.logicgates.classroom.message; Style: (FontSize: 18, TextColor: #ffffff); }
          Label #MessageText { Anchor: (Height: 80, Bottom: 12); Style: (FontSize: 17, Wrap: true, TextColor: #c8d3e0); }
        }
        Group #EnrollmentForm {
          Visible: false;
          LayoutMode: Top;
          Label { Anchor: (Height: 28, Bottom: 8); Text: %server.logicgates.classroom.enrollment; Style: (FontSize: 18, TextColor: #ffffff); }
          $C.@TextField #Enrollment { @Anchor = (Bottom: 12); MaxLength: 64; }
        }
        Group #Actions {
          LayoutMode: Top;
          $C.@TextButton #Primary { @Anchor = (Height: 40, Bottom: 8); @Text = %server.logicgates.classroom.request; Visible: false; }
          $C.@SecondaryTextButton #Secondary { @Anchor = (Height: 40, Bottom: 8); @Text = %server.logicgates.classroom.cancel; Visible: false; }
          $C.@CancelTextButton #Danger { @Anchor = (Height: 40, Bottom: 8); @Text = %server.logicgates.classroom.remove; Visible: false; }
          $C.@SecondaryTextButton #CancelConfirm { @Anchor = (Height: 40, Bottom: 8); @Text = %server.logicgates.classroom.cancel; Visible: false; }
        }
        Group #Form {
          Visible: false;
          LayoutMode: Top;
          Label { Anchor: (Height: 28, Bottom: 8); Text: %server.logicgates.classroom.name; Style: (FontSize: 18, TextColor: #ffffff); }
          $C.@TextField #Name { @Anchor = (Bottom: 16); MaxLength: 64; }
          Label { Anchor: (Height: 28, Bottom: 8); Text: %server.logicgates.classroom.description; Style: (FontSize: 18, TextColor: #ffffff); }
          $C.@MultilineTextField #Description { @Anchor = (Height: 150, Bottom: 16); MaxLength: 2048; }
          Group #MessageEditor {
            Visible: false;
            LayoutMode: Top;
            Label { Anchor: (Height: 28, Bottom: 8); Text: %server.logicgates.classroom.message; Style: (FontSize: 18, TextColor: #ffffff); }
            $C.@MultilineTextField #Message { @Anchor = (Height: 150, Bottom: 16); MaxLength: 2048; }
          }
          $C.@TextButton #Save { @Anchor = (Width: 250, Height: 40); @Text = %server.logicgates.classroom.save; Disabled: true; }
        }
        Label #NoAccess { Visible: false; Anchor: (Height: 110); Text: %server.logicgates.classroom.noAccess; Style: (FontSize: 18, Wrap: true, TextColor: #c8d3e0); }
      }
    }
    Label #Status { Anchor: (Height: 44, Bottom: 8); Text: %server.logicgates.classroom.loading; Style: (FontSize: 16, Wrap: true, TextColor: #c8d3e0); }
    Group {
      LayoutMode: Left;
      Anchor: (Height: 40);
      $C.@SecondaryTextButton #Reload { @Anchor = (Width: 170, Right: 12); @Text = %server.logicgates.classroom.reload; }
      $C.@CancelTextButton #Close { @Anchor = (Width: 160, Right: 18); @Text = %server.logicgates.classroom.probe.close; }
      Label #Build { FlexWeight: 1; Style: (FontSize: 12, Wrap: true, TextColor: #9daec2); }
    }
  }
}
